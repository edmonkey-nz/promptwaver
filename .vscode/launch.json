{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PromptWaver: web (no hardware)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": true
